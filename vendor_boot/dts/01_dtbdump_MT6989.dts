/dts-v1/;

/ {
	model = "MT6989";
	compatible = "mediatek,MT6989";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	aliases {
		i2c0 = "/i2c@11f00000";
		i2c1 = "/i2c@11d00000";
		i2c2 = "/i2c@11d20000";
		i2c3 = "/i2c@11d01000";
		i2c4 = "/i2c@11d21000";
		i2c5 = "/i2c@11d02000";
		i2c6 = "/i2c@11f01000";
		i2c7 = "/i2c@11d22000";
		i2c8 = "/i2c@11d23000";
		i2c9 = "/i2c@11d03000";
		i2c10 = "/i2c@11280000";
		i2c11 = "/i2c@11281000";
		i2c12 = "/i2c@11282000";
		i2c13 = "/i2c@11283000";
		scp-i2c1 = "/i2c@1cbb1000";
		mml-wrot0 = "/soc/mml-wrot0@1f80f000";
		mml-wrot2 = "/soc/mml-wrot2@1f815000";
		inlinerotate0 = "/soc/inlinerot@1440b000";
		inlinerotate1 = "/soc/inlinerot@1460b000";
		dli-async12 = "/soc/ovl-dli-async0@14400000";
		dli-async15 = "/soc/ovl1-dli-async0@14600000";
		dlo-async8 = "/soc/ovl-dlo-async0@14400000";
		dlo-async15 = "/soc/ovl1-dlo-async0@14600000";
		mmlsys-cfg = "/soc/mmlsys-config@1f800000";
		mml-mutex = "/soc/mml-mutex0@1f801000";
		y2r4 = "/soc/ovl-disp-y2r0@14412000";
		y2r6 = "/soc/ovl1-disp-y2r0@14612000";
		y2r0 = "/soc/disp-y2r0@14023000";
		r2y0 = "/soc/disp1-r2y0@14216000";
		ovl3 = "/soc/disp-ovl0-2l@14402000";
		ovl4 = "/soc/disp-ovl1-2l@14403000";
		ovl5 = "/soc/disp-ovl2-2l@14404000";
		ovl6 = "/soc/disp1-ovl0-2l@14602000";
		ovl11 = "/soc/disp1-ovl1-2l@14603000";
		ovl12 = "/soc/disp1-ovl2-2l@14604000";
		mdp-rsz0 = "/soc/disp-mdp-rsz0@14407000";
		mdp-rsz1 = "/soc/disp-mdp-rsz1@14607000";
		wdma0 = "/soc/disp-wdma0@1401e000";
		wdma1 = "/soc/disp1-wdma0@1420e000";
		wdma10 = "/soc/disp-wdma0@14408000";
		wdma11 = "/soc/disp-wdma2@1440a000";
		wdma12 = "/soc/disp-wdma0@14608000";
		wdma13 = "/soc/disp-wdma2@1460a000";
		wdma14 = "/soc/disp-ufbc-wdma0@14409000";
		tdshp0 = "/soc/disp-tdshp0@1401c000";
		tdshp1 = "/soc/disp-tdshp1@1401d000";
		color0 = "/soc/disp-color0@1400c000";
		color1 = "/soc/disp-color1@1400d000";
		ccorr0 = "/soc/disp-ccorr0@14006000";
		ccorr1 = "/soc/disp-ccorr1@14007000";
		ccorr2 = "/soc/disp-ccorr2@14008000";
		ccorr3 = "/soc/disp-ccorr3@14009000";
		c3d0 = "/soc/disp-c3d0@14004000";
		c3d1 = "/soc/disp-c3d1@14005000";
		aal0 = "/soc/disp-aal0@14002000";
		aal1 = "/soc/disp-aal1@14003000";
		maal0 = "/soc/disp-mdp-aal0@14013000";
		maal1 = "/soc/disp-mdp-aal1@1401f000";
		gamma0 = "/soc/disp-gamma0@14011000";
		gamma1 = "/soc/disp-gamma1@14012000";
		dither0 = "/soc/disp-dither0@1400e000";
		dither1 = "/soc/disp-dither1@1400f000";
		dither2 = "/soc/disp-dither2@14010000";
		chist0 = "/soc/disp-chist0@1400a000";
		chist1 = "/soc/disp-chist1@1400b000";
		mdp-rdma0 = "/soc/disp-mdp-rdma0@14014000";
		rsz0 = "/soc/disp-rsz0@14019000";
		rsz1 = "/soc/disp-rsz1@1401a000";
		rsz4 = "/soc/ovl-rsz0@14406000";
		rsz5 = "/soc/ovl1-rsz1@14606000";
		postmask0 = "/soc/disp-postmask0@14017000";
		postmask1 = "/soc/disp-postmask1@14018000";
		spr0 = "/soc/disp-spr@1401b000";
		postalign0 = "/soc/disp-postalign0@14024000";
		dsc0 = "/soc/disp1-dsc-wrap0@14206000";
		dsc1 = "/soc/disp1-dsc-wrap1@14207000";
		dsc2 = "/soc/disp1-dsc-wrap2@14208000";
		splitter0 = "/soc/disp1-splitter0@14203000";
		splitter1 = "/soc/disp1-splitter1@14204000";
		oddmr0 = "/soc/disp-oddmr0@14015000";
		dsi0 = "/soc/dsi0@1420a000";
		dsi1 = "/soc/dsi1@1420b000";
		dsi2 = "/soc/dsi2@1420c000";
		mutex0 = "/soc/disp1-mutex0@14201000";
		mtksmmu0 = "/soc/iommu@1ee00000";
		mtksmmu1 = "/soc/iommu@13a00000";
		mtksmmu2 = "/soc/iommu@19c00000";
		mtksmmu3 = "/soc/iommu@10500000";
	};

	aov {
		compatible = "mediatek,aov";
		status = "okay";
		op-mode = <0x01>;
		aie = <0x02>;
		phandle = <0x132>;
	};

	cache-parity {
		compatible = "mediatek,mt6985-cache-parity";
		ecc-irq-support = <0x01>;
		arm-dsu-ecc-hwirq = <0x30>;
		interrupts = <0x00 0x00 0x04 0x00 0x00 0x01 0x04 0x00 0x00 0x02 0x04 0x00 0x00 0x03 0x04 0x00 0x00 0x04 0x04 0x00 0x00 0x05 0x04 0x00 0x00 0x06 0x04 0x00 0x00 0x07 0x04 0x00 0x00 0x10 0x04 0x00>;
	};

	clkbuf-ctrl {
		pmic-supply = <0x03>;
		compatible = "mediatek,mt6989-clkbuf";
		pmic = <0x03>;
		srclken-rc = <0x04>;
		pmif = <0x05 0x00 0x02>;
		phandle = <0x1b5>;
	};

	chosen {
		bootargs = "console=tty0 root=/dev/ram \t\t\t    nosoftlockup kasan.page_alloc.sample=1 \t\t\t    transparent_hugepage=never \t\t\t    cgroup.memory=nosocket,nokmem \t\t\t    disable_dma32=on \t\t\t    8250.nr_uarts=4 \t\t\t    androidboot.hardware=mt6989 \t\t\t    vmalloc=400M swiotlb=noforce \t\t\t    firmware_class.path=/vendor/firmware,/odm/firmware";
		mkp_panic = "on";
		kaslr-seed = <0x00 0x00>;
		phandle = <0x76>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			reg = <0x00>;
			performance-domains = <0x06 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x07 0x08 0x09 0x0a 0x0b>;
			capacity-dmips-mhz = <0x2fe>;
			phandle = <0x12>;
		};

		cpu@1 {
			device_type = "cpu";
			reg = <0x100>;
			performance-domains = <0x06 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x07 0x08 0x09 0x0a 0x0b>;
			capacity-dmips-mhz = <0x2fe>;
			phandle = <0x13>;
		};

		cpu@2 {
			device_type = "cpu";
			reg = <0x200>;
			performance-domains = <0x06 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x07 0x08 0x09 0x0a 0x0b>;
			capacity-dmips-mhz = <0x2fe>;
			phandle = <0x14>;
		};

		cpu@3 {
			device_type = "cpu";
			reg = <0x300>;
			performance-domains = <0x06 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x07 0x08 0x09 0x0a 0x0b>;
			capacity-dmips-mhz = <0x2fe>;
			phandle = <0x15>;
		};

		cpu@100 {
			device_type = "cpu";
			reg = <0x400>;
			performance-domains = <0x06 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x0c 0x0d 0x0e 0x0a 0x0b>;
			capacity-dmips-mhz = <0x3be>;
			phandle = <0x16>;
		};

		cpu@101 {
			device_type = "cpu";
			reg = <0x500>;
			performance-domains = <0x06 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x0c 0x0d 0x0e 0x0a 0x0b>;
			capacity-dmips-mhz = <0x3be>;
			phandle = <0x17>;
		};

		cpu@102 {
			device_type = "cpu";
			reg = <0x600>;
			performance-domains = <0x06 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x0c 0x0d 0x0e 0x0a 0x0b>;
			capacity-dmips-mhz = <0x3be>;
			phandle = <0x18>;
		};

		cpu@200 {
			device_type = "cpu";
			reg = <0x700>;
			performance-domains = <0x06 0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x0f 0x10 0x11 0x0a 0x0b>;
			capacity-dmips-mhz = <0x400>;
			phandle = <0x19>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x12>;
				};

				core1 {
					cpu = <0x13>;
				};

				core2 {
					cpu = <0x14>;
				};

				core3 {
					cpu = <0x15>;
				};

				doe {
					phandle = <0x1b6>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x16>;
				};

				core1 {
					cpu = <0x17>;
				};

				core2 {
					cpu = <0x18>;
				};

				doe {
					phandle = <0x1b7>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x19>;
				};

				doe {
					phandle = <0x1b8>;
				};
			};
		};

		idle-states {
			entry-method = "arm,psci";

			cpuoff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x61>;
				exit-latency-us = <0xfc>;
				min-residency-us = <0x1a36>;
				phandle = <0x07>;
			};

			cpuoff-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x35>;
				exit-latency-us = <0x8f>;
				min-residency-us = <0x848>;
				phandle = <0x0c>;
			};

			cpuoff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x28>;
				exit-latency-us = <0x6b>;
				min-residency-us = <0xa14>;
				phandle = <0x0f>;
			};

			clusteroff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0x6d>;
				exit-latency-us = <0x145>;
				min-residency-us = <0x1a36>;
				phandle = <0x08>;
			};

			clusteroff-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0x3b>;
				exit-latency-us = <0xbc>;
				min-residency-us = <0x848>;
				phandle = <0x0d>;
			};

			clusteroff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0x2b>;
				exit-latency-us = <0x8a>;
				min-residency-us = <0xa14>;
				phandle = <0x10>;
			};

			mcusysoff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010007>;
				local-timer-stop;
				entry-latency-us = <0x54d>;
				exit-latency-us = <0x343>;
				min-residency-us = <0x1a36>;
				phandle = <0x09>;
			};

			mcusysoff-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010007>;
				local-timer-stop;
				entry-latency-us = <0x4b2>;
				exit-latency-us = <0x2a7>;
				min-residency-us = <0x848>;
				phandle = <0x0e>;
			};

			mcusysoff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010007>;
				local-timer-stop;
				entry-latency-us = <0x477>;
				exit-latency-us = <0x263>;
				min-residency-us = <0xa14>;
				phandle = <0x11>;
			};

			system-vcore {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x20100ff>;
				local-timer-stop;
				entry-latency-us = <0x3ac>;
				exit-latency-us = <0xdac>;
				min-residency-us = <0x8980>;
				phandle = <0x0a>;
			};

			s2idle {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x20180ff>;
				local-timer-stop;
				entry-latency-us = <0x2710>;
				exit-latency-us = <0x2710>;
				min-residency-us = <0xffffffff>;
				phandle = <0x0b>;
			};
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	clk-ao {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		phandle = <0x1b9>;
	};

	clkitg {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";
		phandle = <0x1ba>;

		bring-up@0 {
			compatible = "mediatek,clk-bring-up";
			reg = <0x00>;
			clocks = <0x1a 0x13 0x1a 0x3c 0x1a 0x43 0x1b 0x02>;
		};
	};

	disable-unused {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";
		phandle = <0x1bb>;

		disable-unused-clk-mdpsys1@64 {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x64>;
			clocks = <0x1c 0x00 0x1c 0x01 0x1c 0x02 0x1c 0x03 0x1c 0x04 0x1c 0x05 0x1c 0x06 0x1c 0x07 0x1c 0x08 0x1c 0x09 0x1c 0x0a 0x1c 0x0b 0x1c 0x0c 0x1c 0x0d 0x1c 0x0e 0x1c 0x0f 0x1c 0x10 0x1c 0x11 0x1c 0x12 0x1c 0x13 0x1c 0x14 0x1c 0x15 0x1c 0x16 0x1c 0x17 0x1c 0x18 0x1c 0x19 0x1c 0x1a 0x1c 0x1b 0x1c 0x1c 0x1c 0x1d 0x1c 0x1e 0x1c 0x1f 0x1c 0x20 0x1c 0x21 0x1c 0x22 0x1c 0x23 0x1c 0x24 0x1c 0x25 0x1c 0x26 0x1c 0x27 0x1c 0x28 0x1c 0x29 0x1c 0x2a 0x1c 0x2b 0x1c 0x2c 0x1c 0x2d 0x1c 0x2e>;
			power-domains = <0x1d 0x21>;
		};

		disable-unused-clk-mdpsys@65 {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x65>;
			clocks = <0x1e 0x00 0x1e 0x01 0x1e 0x02 0x1e 0x03 0x1e 0x04 0x1e 0x05 0x1e 0x06 0x1e 0x07 0x1e 0x08 0x1e 0x09 0x1e 0x0a 0x1e 0x0b 0x1e 0x0c 0x1e 0x0d 0x1e 0x0e 0x1e 0x0f 0x1e 0x10 0x1e 0x11 0x1e 0x12 0x1e 0x13 0x1e 0x14 0x1e 0x15 0x1e 0x16 0x1e 0x17 0x1e 0x18 0x1e 0x19 0x1e 0x1a 0x1e 0x1b 0x1e 0x1c 0x1e 0x1d 0x1e 0x1e 0x1e 0x1f 0x1e 0x20 0x1e 0x21 0x1e 0x22 0x1e 0x23 0x1e 0x24 0x1e 0x25 0x1e 0x26 0x1e 0x27 0x1e 0x28 0x1e 0x29 0x1e 0x2a 0x1e 0x2b 0x1e 0x2c 0x1e 0x2d 0x1e 0x2e>;
			power-domains = <0x1d 0x20>;
		};

		disable-unused-clk-mminfra-ao-config@66 {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x66>;
			clocks = <0x1f 0x00 0x1f 0x01 0x1f 0x02>;
			power-domains = <0x1d 0x0a>;
		};

		disable-unused-clk-mminfra-config@67 {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x67>;
			clocks = <0x20 0x00>;
			power-domains = <0x1d 0x0a>;
		};

		disable-unused-clk-cam-vcore@68 {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x68>;
			clocks = <0x21 0x00>;
			power-domains = <0x1d 0x17>;
		};

		disable-unused-clk-ccu@69 {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x69>;
			clocks = <0x22 0x00 0x22 0x01 0x22 0x02 0x22 0x03 0x22 0x04>;
			power-domains = <0x1d 0x1c>;
		};

		disable-unused-clk-camsys-ipe@6a {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x6a>;
			clocks = <0x23 0x00 0x23 0x01 0x23 0x02 0x23 0x03 0x23 0x04>;
			power-domains = <0x1d 0x18>;
		};

		disable-unused-clk-camsys-mraw@6b {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x6b>;
			clocks = <0x24 0x00 0x24 0x01 0x24 0x02 0x24 0x03 0x24 0x04 0x24 0x05 0x24 0x06 0x24 0x07 0x24 0x08>;
			power-domains = <0x1d 0x18>;
		};

		disable-unused-clk-camsys-yuvc@6c {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x6c>;
			clocks = <0x25 0x00 0x25 0x01 0x25 0x02>;
			power-domains = <0x1d 0x1b>;
		};

		disable-unused-clk-camsys-rawc@6d {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x6d>;
			clocks = <0x26 0x00 0x26 0x01 0x26 0x02>;
			power-domains = <0x1d 0x1b>;
		};

		disable-unused-clk-camsys-rmsc@6e {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x6e>;
			clocks = <0x27 0x00 0x27 0x01 0x27 0x02>;
			power-domains = <0x1d 0x1b>;
		};

		disable-unused-clk-camsys-yuvb@6f {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x6f>;
			clocks = <0x28 0x00 0x28 0x01 0x28 0x02>;
			power-domains = <0x1d 0x1a>;
		};

		disable-unused-clk-camsys-rawb@70 {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x70>;
			clocks = <0x29 0x00 0x29 0x01 0x29 0x02>;
			power-domains = <0x1d 0x1a>;
		};

		disable-unused-clk-camsys-rmsb@71 {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x71>;
			clocks = <0x2a 0x00 0x2a 0x01 0x2a 0x02>;
			power-domains = <0x1d 0x1a>;
		};

		disable-unused-clk-camsys-yuva@72 {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x72>;
			clocks = <0x2b 0x00 0x2b 0x01 0x2b 0x02>;
			power-domains = <0x1d 0x19>;
		};

		disable-unused-clk-camsys-rawa@73 {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x73>;
			clocks = <0x2c 0x00 0x2c 0x01 0x2c 0x02>;
			power-domains = <0x1d 0x19>;
		};

		disable-unused-clk-camsys-rmsa@74 {
			compatible = "mediatek,clk-disable-unused";
			reg = <0x74>;
			clocks = <0x2d 0x00 0x2d 0x01 0x2d 0x02>;
			power-domains = <0x1d 0x19>;
		};

		disable-unused-clk-camsys-main@75 {
