				pins_cmd_dat {
					pinmux = <0xca01 0xc901 0xc701>;
					slew-rate = <0x00>;
					drive-strength = <0x02>;
					bias-pull-down;
				};
			};

			spi0_cs_active {
				phandle = <0x21>;

				pins_cmd_dat {
					pinmux = <0xc801>;
					slew-rate = <0x00>;
					drive-strength = <0x02>;
					bias-pull-up;
				};
			};

			spi0_sleep {
				phandle = <0x24>;

				pins_cmd_dat {
					pinmux = <0xc700 0xc800 0xc900 0xca00>;
					slew-rate = <0x00>;
					bias-pull-down;
					input-enable;
				};
			};

			uart1_tx_active {
				phandle = <0x22>;

				pins_cmd_dat {
					pinmux = <0xcd01>;
					slew-rate = <0x00>;
					bias-disable;
				};
			};

			uart1_rx_active {
				phandle = <0x23>;

				pins_cmd_dat {
					pinmux = <0xce01>;
					slew-rate = <0x00>;
					bias-disable;
				};
			};

			uart1_sleep {
				phandle = <0x25>;

				pins_cmd_dat {
					pinmux = <0xcd00 0xce00>;
					slew_rate = <0x00>;
					bias-pull-down;
					input-anable;
				};
			};
		};
	};

