	fragment@11 {
		target = <0xffffffff>;

		__overlay__ {

			lcd-bias-enp1-gpio {
				phandle = <0x03>;

				pins-cmd-dat {
					pinmux = <0xde00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			lcd-bias-enp0-gpio {
				phandle = <0x04>;

				pins-cmd-dat {
					pinmux = <0xde00>;
					slew-rate = <0x01>;
					output-low;
