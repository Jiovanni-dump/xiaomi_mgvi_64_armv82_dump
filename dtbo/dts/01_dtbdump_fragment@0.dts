				pins-cmd-dat {
					pinmux = <0xd700>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			lcm-dsi1-te {
				phandle = <0x0c>;

				pins-cmd-dat {
					pinmux = <0xa01>;
				};
