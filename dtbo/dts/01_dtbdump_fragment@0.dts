/dts-v1/;

/ {

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {

			simtray {
				compatible = "xiaomi,simtray-status";
				status-gpio = <0xffffffff 0xd4 0x00>;
			};
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {

			t1_gpio_vc_all {
				phandle = <0x01>;

				pins_cmd_dat {
					pinmux = <0x3d00 0x3c00 0x3b00>;
					drive-strength = <0x02>;
					bias-disable;
					output-low;
				};
			};
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {

			mi_t1_chip {
				compatible = "mdm,mi_t1_chip";
				t1_ant4_vc1 = <0xffffffff 0x3d 0x00>;
				t1_ant4_vc2 = <0xffffffff 0x3c 0x00>;
				t1_ant4_vc3 = <0xffffffff 0x3b 0x00>;
				pinctrl-names = "t1_gpio_vc_all";
				pinctrl-0 = <0x01>;
			};
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {

			xiaomi_wifi_gpio {
				phandle = <0x02>;

				pins_cmd_dat {
					pinmux = <0x6d00>;
					drive-strength = <0x02>;
					bias-disable;
					input-enable;
				};
			};
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {

			xiaomi_wifi_gpio {
				compatible = "wlan,xiaomi_wifi_gpio";
				status-gpio = <0xffffffff 0x6d 0x00>;
				debounce-time = <0x1e>;
				pinctrl-names = "default";
				pinctrl-0 = <0x02>;
			};
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {
			bootargs_ext = "log_buf_len=4M";
		};
	};

	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {
			compatible = "mediatek,disp-leds";

			backlight {
				max-brightness = <0x3fff>;
				min-brightness = <0x01>;
				max-hw-brightness = <0x3fff>;
				led_mode = <0x04>;
				default-state = "FifteenPercent";
			};
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {

			vin1_open {
				channel = <0x13>;
