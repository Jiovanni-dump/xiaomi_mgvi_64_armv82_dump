	fragment@15 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			init-panel-off;

			panel1@0 {
				compatible = "truly,td4330,cmd";
				reg = <0x00>;
				reset-gpios = <0xffffffff 0x09 0x00>;
				swap-from-dts;
				lane-swap-setting = <0x01 0x02 0x00 0x03 0x04 0x02>;
				pn-swap-setting = <0x01 0x01 0x01 0x01 0x01 0x01>;
				gate-ic = <0x12df>;
