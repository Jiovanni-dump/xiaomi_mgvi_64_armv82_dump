			lcm-dsi-gpio {
				phandle = <0x8c>;

				pins-cmd-dat {
					pinmux = <0xe500>;
				};
			};

			lcm-dsi1-gpio {
				phandle = <0x8d>;

				pins-cmd-dat {
					pinmux = <0xa00>;
				};
